# Archery timer UI on the local display: SDL2 KMSDRM kiosk on tty1, no X11.
# Options (profile, display, renderer) go in /etc/archerytimer/ui.env: UI_ARGS="--profile audience"
[Unit]
Description=Archery timer UI (kiosk)
After=archerytimer-core.service systemd-user-sessions.service
Wants=archerytimer-core.service
Conflicts=getty@tty1.service
After=getty@tty1.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=archery
Group=archery
SupplementaryGroups=video render input audio tty
WorkingDirectory=/opt/archerytimer
# A logind session on tty1 gives the UI DRM master access without root.
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=PYGAME_HIDE_SUPPORT_PROMPT=1
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_RENDER_DRIVER=opengles2
Environment=SDL_AUDIODRIVER=dummy
EnvironmentFile=-/etc/archerytimer/ui.env
ExecStart=/opt/archerytimer/.venv/bin/python -m archerytimer.ui_client --fullscreen $UI_ARGS
TimeoutStopSec=5
# The UI has no timing authority: restarting it never affects timer, lights or sound.
Restart=always
RestartSec=1
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
